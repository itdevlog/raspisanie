# Telegram Bot Token (получите у @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Настройки обновления данных
UPDATE_INTERVAL=3600
MAX_RETRIES=3
# Сколько школ грузить параллельно (1 — последовательно). Ускоряет обновление при 3+ школах.
MAX_PARALLEL_SCHOOLS=4

# Необязательный внешний JSON со школами: {"school_id": {...}}. Внешние записи
# переопределяют встроенные из config/schools.py, остальные сохраняются.
# Относительный путь — от рабочего каталога запуска. Пусто — только встроенные.
SCHOOLS_CONFIG_FILE=

# Администраторы (Telegram user_id через запятую)
ADMIN_IDS=

# Настройки базы данных
DB_PATH=./data/database.json
CACHE_PATH=./data/cache.json

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
ADMIN_LOG_FILE=./logs/admin.log

# Часовой пояс (по умолчанию Екатеринбург = UTC+5)
TIMEZONE=Asia/Yekaterinburg

# Веб-версия (Telegram Mini App)
# Хост/порт FastAPI-сервера (работает в процессе бота).
# 127.0.0.1 безопаснее: порт бота не торчит в интернет, доступ только через Caddy.
# Для нескольких ботов на одном сервере задайте каждому свой WEBAPP_PORT (8080, 8081, ...).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Публичный HTTPS-URL фронтенда (требование Telegram для кнопок Mini App).
# Без него бот работает как раньше, кнопка веб-расписания не добавляется.
# Пример: https://schedule.example.com
WEBAPP_URL=

# Публичный сайт расписания и Web Push.
#
# Разделение origin/edge: origin (Германия) хранит бота, загружает данные,
# отправляет push и ПУБЛИКУЕТ снапшот на edge. Edge (Москва) отдаёт публичный
# сайт за Caddy с TLS и ПРОКСИРУЕТ публичное push-API на origin.
# Полный справочник — docs/EDGE.md и deploy/edge/README.md; шаблон edge-хоста —
# deploy/edge/edge.env.example (копируется в /etc/raspisanie-edge.env).
#
# Держите NTP синхронизированным на ОБОИХ хостах: origin/edge принимают снапшот
# с допуском ±300 с по X-Snapshot-Timestamp (web/edge_ingest.py).

# --- edge-only: внутренний HTTP edge-сервера ---
# Слушать только loopback; наружу — Caddy. EDGE_PORT должен совпадать с портом
# в deploy/edge/Caddyfile.
EDGE_HOST=127.0.0.1
EDGE_PORT=8090

# --- снапшот расписания (используется на обоих хостах) ---
# SNAPSHOT_PATH — файл снапшота (origin пишет, edge принимает).
# SNAPSHOT_MAX_AGE — возраст (сек) до пометки stale.
# SNAPSHOT_MAX_BYTES — максимальный размер снапшота (байт).
SNAPSHOT_PATH=./data/snapshot.json
SNAPSHOT_MAX_AGE=7200
SNAPSHOT_MAX_BYTES=20971520
# --- origin-only: ретраи публикации снапшота на edge ---
# Не путать с MAX_RETRIES загрузки данных. На edge не используется.
SNAPSHOT_MAX_RETRIES=3

# --- origin-only: публикация снапшота на edge ---
# URL ingest-эндпоинта edge, куда origin шлёт снапшот (пусто — публикация
# выключена). Пример: https://raspisanie.example.ru/internal/snapshot
# EDGE_INGEST_SECRET — общий секрет для HMAC-подписи тела снапшота.
EDGE_INGEST_URL=
EDGE_INGEST_SECRET=

# --- origin+edge: общий секрет origin↔edge ---
# Edge добавляет X-Edge-Auth при проксировании публичного push-API на origin;
# origin сверяет его. Секрет должен совпадать на обоих хостах.
EDGE_AUTH_SECRET=

# --- edge-only: прокси push на origin ---
# Базовый URL origin. Нужен только edge; на origin можно оставить пустым.
# Без него (и без EDGE_AUTH_SECRET) push-маршруты на edge не регистрируются.
EDGE_ORIGIN_URL=

# --- Web Push (VAPID) ---
# Сгенерировать пару: python -m services.push_keys.
# Приватный ключ — секрет, в репозиторий не коммитить.
# origin-only: VAPID_PRIVATE_KEY нужен origin для отправки push.
# edge-only: публичный ключ отдаётся edge-ом браузеру локально.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# WEBAPP_URL выше должен указывать на публичный .ru-домен: Telegram Mini App
# открывается из РФ через edge (см. docs/EDGE.md §2, §4).

# Опционально: внешний мониторинг ошибок через Sentry. Работает, только если
# задан DSN И установлен пакет sentry-sdk (в requirements.txt он НЕ входит —
# поставьте вручную: pip install sentry-sdk). Иначе Sentry тихо выключен.
# SENTRY_DSN=