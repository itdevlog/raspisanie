# Caddyfile — TLS reverse proxy для Telegram Mini App.
#
# Домен подставляется manage.sh из WEBAPP_URL (.env): WEBAPP_URL=https://raspisanie.devlogit.ru
# → webapp_domain=raspisanie.devlogit.ru, Caddy сам получает Let's Encrypt сертификат
# и делает HTTP→HTTPS редирект.
#
# Плейсхолдеры (env Caddy):
#   WEBAPP_DOMAIN — публичный домен без схемы
#   WEBAPP_PORT   — локальный порт бота (по умолчанию 8080)
{$WEBAPP_DOMAIN:localhost} {
	reverse_proxy 127.0.0.1:{$WEBAPP_PORT:8080}
}
