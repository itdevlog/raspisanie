# deploy/edge/edge.env.example — переменные edge-хоста (публичный сайт, Москва).
#
# install.sh копирует этот файл в /etc/raspisanie-edge.env (если его ещё нет) и
# подключает его systemd-юнитом через EnvironmentFile. Полный справочник —
# .env.example в корне репозитория и docs/EDGE.md.
#
# Секреты (EDGE_INGEST_SECRET, EDGE_AUTH_SECRET, VAPID_*) НЕ коммитьте сюда:
# заполняйте уже установленный /etc/raspisanie-edge.env на сервере.

# --- Внутренний HTTP приложения -------------------------------------------------
# Слушать только на loopback: наружу — Caddy с TLS. EDGE_PORT должен совпадать
# с портом в deploy/edge/Caddyfile (install.sh передаёт его как {$EDGE_PORT}).
EDGE_HOST=127.0.0.1
EDGE_PORT=8090

# --- Снапшот расписания ---------------------------------------------------------
# Абсолютный путь: юнит запускается из EDGE_DIR, но надёжнее задать явно.
# install.sh создаёт каталог и выдаёт на него права пользователю сервиса.
SNAPSHOT_PATH=/var/lib/raspisanie-edge/snapshot.json
# Возраст (сек), после которого healthz/UI помечают данные устаревшими.
SNAPSHOT_MAX_AGE=7200
# Максимальный принимаемый размер снапшота (байт).
SNAPSHOT_MAX_BYTES=20971520
# Ретраи публикации на стороне origin (edge не использует, но AppConfig читает).
SNAPSHOT_MAX_RETRIES=3

# --- Секреты обмена с origin ---------------------------------------------------
# Общий секрет HMAC-подписи входящего снапшота (совпадает с origin).
EDGE_INGEST_SECRET=
# Общий секрет origin<->edge для проксирования публичного push-API.
EDGE_AUTH_SECRET=

# --- Проксирование push на origin (только edge) --------------------------------
# Базовый URL origin. Без него публичные push-эндпоинты не регистрируются
# (vapid-public-key останется 404, subscribe/unsubscribe будут отсутствовать).
EDGE_ORIGIN_URL=https://origin.example.com

# --- Web Push (VAPID) ----------------------------------------------------------
# Публичный ключ отдаётся браузеру эндпоинтом /api/push/vapid-public-key.
VAPID_PUBLIC_KEY=
# Приватный ключ нужен origin для отправки; на edge может оставаться пустым,
# если edge не отправляет push сам.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# --- Логирование ---------------------------------------------------------------
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
